      "payment": {"payee": "northwind-paper.testnet", "amount": "1250", "asset": "USDC"},
      "trusted": ["northwindpaper.testnet"],
      "rules_expect": ["NEW_ACCOUNT", "DETAILS_CHANGED", "LOOKALIKE_PAYEE", "AMOUNT_MISMATCH"]
    },
    {
      "id": "benign",
      "file": "dinner_split.txt",
      "sender": "Ravi",
