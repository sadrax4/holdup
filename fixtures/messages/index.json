{
  "description": "Fictional sample messages for demos and tests. Every brand, person and account in them is made up. Offline and testnet demos pay in the HUSD demo token unless Circle USDC is configured.",
  "fictional": true,
  "placeholders": {
    "base_url": "PUBLIC_BASE_URL of the running HoldUp web app, which serves the training fixture pages"
  },
  "messages": [
    {
      "id": "hero",
      "file": "coinhaven_dm.txt",
      "sender": "CoinHaven Support",
      "label": "Fake exchange support DM (training sample)",
      "payment": {"payee": "safe-wallet-77.testnet", "amount": "50", "asset": "USDC"},
      "trusted": [],
      "rules_expect": ["NEW_ACCOUNT", "MULE_PATTERN", "IMPERSONATION", "URGENCY", "CHECKER_INJECTION"]
    },
    {
      "id": "invoice",
      "file": "northwind_invoice.txt",
