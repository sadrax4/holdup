# Caddy in front of HoldUp. deploy/docker-compose.yml mounts this file read-only and sets:
#
#   HOLDUP_HOST   the bot's host: web pages, Telegram webhook (/tg/...), /mcp, /validate, /health
#   FIXTURE_HOST  a second host that serves only the /fixtures/ training pages
#   ACME_EMAIL    contact address for the certificate authority
#
# Caddy obtains and renews certificates for both hosts by itself; ports 80 and 443 must be
# reachable from the internet. No domain is needed: sslip.io names resolve to the IP address
# written in them, so a server at 203.0.113.7 can use
#
#   HOLDUP_HOST=holdup.203-0-113-7.sslip.io
#   FIXTURE_HOST=fixtures.203-0-113-7.sslip.io
#
# The training pages imitate a phishing site (fictional brands, clearly labelled). Serving them
# from their own origin means a phishing report or blocklist entry for them names FIXTURE_HOST,
# not the host that the bot and its webhook depend on.

{
	email {$ACME_EMAIL}
}

{$HOLDUP_HOST} {
	request_body {
		max_size 2MB
	}

	# This host never serves the training pages itself; old links are sent to FIXTURE_HOST.
	@fixtures path /fixtures /fixtures/*
	redir @fixtures https://{$FIXTURE_HOST}{uri} 302

	reverse_proxy holdup:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$FIXTURE_HOST} {
	# Read-only training pages and nothing else: no other path, no other method.
	@fixtures {
		path /fixtures /fixtures/*
		method GET HEAD
	}
	handle @fixtures {
		reverse_proxy holdup:8000
	}
	handle {
		respond "Not found" 404
	}

	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "form-action 'none'; frame-ancestors 'none'; base-uri 'none'"
		-Set-Cookie
		-Server
	}
}
