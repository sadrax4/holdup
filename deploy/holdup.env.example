# HoldUp server settings, read by deploy/docker-compose.yml.
#
# Copy to ~/work/secrets/holdup.env (mode 600, outside the repository) and fill it in.
# deploy/setup-ubuntu.sh makes that copy for you, generates HOLDUP_SECRET and
# TELEGRAM_WEBHOOK_SECRET, and fills in sslip.io host names when it can see a public IPv4 address.
#
# Format: KEY=value, one per line, no spaces around "=", comments on their own lines. Quotes are
# not needed; a value containing $ or spaces must be wrapped in single quotes. An empty value means
# "not set" (the default applies). Never commit the filled-in file.

# --- Host names (Docker Compose and Caddy) ------------------------------------------------------

# Host name of the bot and web app, without https:// (e.g. holdup.203-0-113-7.sslip.io).
HOLDUP_HOST=
# A different host name that serves only the /fixtures/ training pages (e.g. fixtures.203-0-113-7.sslip.io).
FIXTURE_HOST=
# Your email address for the certificate authority account (Let's Encrypt, ZeroSSL fallback).
ACME_EMAIL=

# --- Web and Telegram ---------------------------------------------------------------------------

# Public base URL; docker-compose.yml sets it to https://$HOLDUP_HOST, so set it only outside Compose.
# PUBLIC_BASE_URL=
# Bot token from @BotFather (digits, a colon, then letters and digits).
TELEGRAM_BOT_TOKEN=
# Webhook secret: the <secret> in /tg/<secret> and the secret_token Telegram sends; 1-256 of A-Z a-z 0-9 _ -.
TELEGRAM_WEBHOOK_SECRET=

# --- Server identity ----------------------------------------------------------------------------

# Root secret every user's NEAR account and key is derived from: generate once, back up, never change.
HOLDUP_SECRET=

# --- NEAR (written by `holdup deploy`; deploy/credentials_to_env.py copies them here) -----------

# offline (in-memory demo vault), sandbox or testnet; empty: the credentials file's value, else offline.
HOLDUP_NETWORK=
# NEAR RPC endpoint; empty: the network's default (https://rpc.testnet.near.org on testnet).
NEAR_RPC_URL=
# Account the deployment lives under, e.g. yourname.testnet; the vault, oracle and keeper are its sub-accounts.
HOLDUP_ROOT_ACCOUNT=
# HoldVault contract account; empty: vault.<root account>.
HOLDUP_VAULT_ACCOUNT=
# Oracle account(s) allowed to extend holds, comma separated; empty: oracle.<root account>.
HOLDUP_ORACLE_ACCOUNTS=
# Keeper account that releases due holds; empty: keeper.<root account>.
HOLDUP_KEEPER_ACCOUNT=
# Private key (ed25519:...) of the root account, which acts as treasury and onboards new users.
HOLDUP_TREASURY_KEY=
# Private key of the oracle account; its only key is limited to calling extend_hold on the vault.
HOLDUP_ORACLE_KEY=
# Private key of the keeper account; its only key is limited to calling release on the vault.
HOLDUP_KEEPER_KEY=
# HUSD demo token contract (husd.<root account> after `holdup deploy`); not Circle USDC.
HOLDUP_HUSD_TOKEN=
# Circle USDC token contract; empty: Circle's testnet USDC on testnet, none elsewhere.
HOLDUP_USDC_TOKEN=
# Demo NEAR given to each new user, in yoctoNEAR; empty: 2 NEAR.
HOLDUP_DEMO_NEAR_YOCTO=
# Demo HUSD given to each new user, in base units (6 decimals); empty: 2,000 HUSD.
HOLDUP_DEMO_HUSD=
# Credentials JSON from `holdup deploy`; values set above win over it. In the container the default
# (.holdup/credentials.json) is /data/credentials.json on the data volume.
# HOLDUP_CREDENTIALS=

# --- Otari gateway (open-weight model checks) ---------------------------------------------------

# Otari API key (otk_v1_...); empty: recorded responses are replayed instead of live calls.
OTARI_API_KEY=
# live, replay or off (rules only); empty: live when OTARI_API_KEY is set, else replay.
OTARI_MODE=
# Gateway URL; empty: https://api.otari.ai/api/v1, or the EU endpoint for otk_v1_eu_ keys.
OTARI_BASE_URL=
# Optional pool of pre-made Otari keys, comma separated; each account is always given the same one.
OTARI_USER_KEYS=

# --- Storage ------------------------------------------------------------------------------------

# SQLite file inside the container; keep it under /data (the holdup-data volume). Default shown.
# HOLDUP_DB=/data/holdup.sqlite3
