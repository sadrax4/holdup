# HoldUp settings for scripts/server.sh: ~/work/secrets/holdup.env (mode 600).
#
# `bash scripts/server.sh setup` writes this file for you: it asks for the two keys, generates
# the two secrets and never overwrites a value that is already set. Edit it by hand to change
# something, then run `bash scripts/server.sh restart`.
#
# Format: KEY='value', one per line; comments on their own lines or after a value and a space
# (KEY='value'  # note). Values may not contain quotes or line breaks. The file is read as data,
# never executed. Never commit a filled-in copy. For an install without a terminal, setup takes
# the values from HOLDUP_<NAME> in the environment (HOLDUP_TELEGRAM_BOT_TOKEN, ...), never from
# the plain names, which another bot on the same account may use.
#
# scripts/server.sh sets these itself, so they do not belong here: PUBLIC_BASE_URL and
# FIXTURE_BASE_URL (the two quick tunnel addresses), HOLDUP_PORT, HOLDUP_DB, HOLDUP_CREDENTIALS
# (~/work/secrets/holdup-credentials.json) and HOLDUP_NETWORK.

# --- Asked for by setup -------------------------------------------------------------------------

# Otari API key (otk_...). Empty, with OTARI_MODE='off': payments are checked by the rules only.
OTARI_API_KEY=''
# Bot token from @BotFather: digits, a colon, then letters, digits, _ and -.
TELEGRAM_BOT_TOKEN=''

# --- Generated by setup -------------------------------------------------------------------------

# Every user's NEAR account and key are derived from this: back it up, and never change it once
# people use the bot. It must match the "secret" in holdup-credentials.json.
HOLDUP_SECRET=''
# Only used in webhook mode: the <secret> in /tg/<secret> and Telegram's secret_token header.
TELEGRAM_WEBHOOK_SECRET=''
# polling (the default; no inbound connection needed), webhook (needs a stable https URL) or off.
TELEGRAM_MODE='polling'

# --- Optional -----------------------------------------------------------------------------------

# live or off; empty: live when OTARI_API_KEY is set. "replay" is refused on testnet.
# OTARI_MODE=''
# Gateway URL; empty: https://api.otari.ai/api/v1, or the EU endpoint for otk_v1_eu_ keys.
# OTARI_BASE_URL=''
# A pool of pre-made Otari keys, comma separated; each user is always given the same one.
# OTARI_USER_KEYS=''
# NEAR testnet RPC; empty: https://test.rpc.fastnear.com. With a FastNEAR API key, put it in the
# query (https://test.rpc.fastnear.com/?apiKey=...): HoldUp keeps the query out of its logs and pages.
# NEAR_RPC_URL=''
# Test NEAR each new user gets in the vault, in yoctoNEAR; default 0.2 NEAR (2e23).
# HOLDUP_DEMO_NEAR_YOCTO='200000000000000000000000'
# Automatic faucet top-ups of the treasury on testnet: on or off (default on), the balance in
# NEAR below which it asks (default 1.5), and at most how often (seconds) and how many times a day.
# HOLDUP_FAUCET='on'
# HOLDUP_FAUCET_BELOW_NEAR='1.5'
# HOLDUP_FAUCET_INTERVAL_S='600'
# HOLDUP_FAUCET_PER_DAY='30'
# Another Bot API server, for tests or a self-hosted Bot API only; empty: Telegram's own.
# TELEGRAM_API_BASE_URL=''
# Circle's testnet USDC as a second stablecoin of the vault. Only before the testnet step (the
# vault's token list is fixed when it is deployed); empty: HUSD only, which new users are funded with.
# HOLDUP_USDC_TOKEN='3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af'
